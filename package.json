{
  "name": "petopia",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start -c",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "axios": "^1.9.0",
    "babel-preset-expo": "~57.0.0",
    "camelcase-keys": "^9.1.3",
    "expo": "^57.0.0",
    "expo-av": "^15.1.4",
    "expo-checkbox": "~57.0.0",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "i18next": "^25.1.2",
    "nativewind": "latest",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.56.3",
    "react-i18next": "^15.5.1",
    "react-native": "0.86.3",
    "react-native-app-intro-slider": "^4.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "snakecase-keys": "^8.0.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3"
  },
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-redux",
          "react-native-restart",
          "expo-av"
        ]
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo",
        "typescript"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3rChuss/zooki.git"
  }
}
